#!/usr/bin/env bash
# Install Encore from a clone, before Encore exists on the machine (SAPRS 13.7, ADR-014).
#
#   sudo ./scripts/encore-install install
#   sudo ./scripts/encore-install verify
#   ./scripts/encore-install install --root /tmp/rehearsal --no-service --dry-run
#
# The wrapper exists for one reason and has no logic: `encore-install` is a console script of the
# distribution, so after the first install it is on `PATH` — but the command that has to work is
# the one you run before anything is installed, from a checkout, as root. `uv run` solves that
# without touching system Python (SAPRS 13.4's rule binds the install, not the installer).
#
# Everything after this file's exec line is `apps/installer/`'s behaviour. A bootstrap script that
# had its own opinions about the appliance would be a second installer, and the two would disagree
# in the manner of all duplicated rules: quietly, and on the machine that matters.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Find uv. `command -v` alone is not enough and the reason is #38: the documented way to install
# uv is the astral script, which writes `~/.local/bin`, and the documented way to run this script
# is `sudo` — which replaces PATH with its `secure_path`. So a correctly-installed uv is invisible
# to a correctly-invoked installer, and the message below blamed a missing tool that was there.
#
# The candidate list mirrors `USER_BIN_DIRS` in `apps/installer/system.py`, which owns the rule;
# keep the two in step. This file has to resolve uv before any Python exists to ask, which is the
# one legitimate reason for it to have a copy of anything.
if command -v uv >/dev/null 2>&1; then
  UV_BIN="$(command -v uv)"
else
  UV_BIN=""
  # `SUDO_USER`'s home as well as `HOME`: under sudo, `HOME` is /root and uv is in the caller's.
  for home in "${HOME:-/root}" "$(getent passwd "${SUDO_USER:-}" 2>/dev/null | cut -d: -f6)"; do
    for dir in .local/bin bin .cargo/bin; do
      if [[ -x "$home/$dir/uv" ]]; then
        UV_BIN="$home/$dir/uv"
        break 2
      fi
    done
  done
fi

if [[ -z "$UV_BIN" ]]; then
  cat >&2 <<'MISSING'
uv is required to install Encore (AIG 3), and this machine does not have it where this command
looked.

  curl -LsSf https://astral.sh/uv/install.sh | sh

Then re-run this. `uv` is the only thing the bootstrap needs: the installer itself is in this
repository and resolves its dependencies into /opt/encore/venv, not into your system Python.

If uv is already installed: the astral installer puts it in ~/.local/bin, and `sudo` does not
copy that onto root's PATH. Either run this as the user who installed uv (sudo keeps SUDO_USER's
home in mind), or name the directory explicitly:

  sudo PATH="$PATH" ./scripts/encore-install install
MISSING
  exit 3  # EXIT_PREREQUISITES, the same value `apps/installer/main.py` uses
fi

# The directory that held uv goes on PATH, so the installer and everything it spawns resolve the
# tool the same way this script did. One answer, from here to `uv sync`.
export PATH="$PATH:$(dirname "$UV_BIN")"

# The credential has exactly one route in, and it is not a flag: see ADR-015 and SAPRS 12.6. A
# `--admin-password` would put it in `ps` output and shell history, which is a worse version of the
# thing 12.6 exists to prevent — so it is passed through the environment, and `sudo` has to be told
# not to scrub it.
if [[ -n "${ENCORE_ADMIN_PASSWORD:-}" && "$(id -u)" == "0" ]]; then
  export ENCORE_ADMIN_PASSWORD
fi

exec "$UV_BIN" run --frozen --no-dev python -m apps.installer.main "$@"
